---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
import { SITE_TITLE } from "../../consts";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const categories = ["スマートウォッチ", "スマートホーム", "アプリ", "買い物"];
  return categories.map((cat) => ({
    params: { category: cat },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const allPosts = await getCollection("blog");

function categoryOf(tags: string[] | undefined) {
  const t = tags || [];
  if (t.includes("Amazfit") || t.includes("T-Rex 2") || t.includes("スマートウォッチ")) return "スマートウォッチ";
  if (t.includes("SESAME") || t.includes("スマートホーム")) return "スマートホーム";
  if (t.includes("AliExpress") || t.includes("買い物")) return "買い物";
  if (t.includes("Androidアプリ") || t.includes("音声入力") || t.includes("アプリ")) return "アプリ";
  return t[0] || "その他";
}

const posts = allPosts
  .filter((p) => categoryOf(p.data.tags) === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function fmtDate(d: Date) {
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return d.getFullYear() + "." + m + "." + day;
}
---
<html lang="ja">
<head>
  <BaseHead title={`${category}の記事一覧 | ${SITE_TITLE}`} description={`${category}に関する記事一覧です。`} />
</head>
<body>
  <Header />
  <section style="background-color: var(--navy); color: #fff; padding: 40px 24px; text-align: center;">
    <div style="max-width: 1120px; margin: 0 auto;">
      <span style="font-family: Poppins, sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 3px; color: var(--yellow); display: block; margin-bottom: 10px;">CATEGORY</span>
      <h1 style="font-size: 28px; margin: 0;">{category}</h1>
    </div>
  </section>
  <main class="container-1col" style="max-width: 900px; margin: 40px auto; padding: 0 24px;">
    {posts.length === 0 ? (
      <p>このカテゴリーの記事はまだありません。</p>
    ) : (
      <div style="display: flex; flex-direction: column; gap: 20px;">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="wn-item" style="display: flex; gap: 16px; padding: 14px; text-decoration: none; color: inherit; align-items: center;">
            {post.data.heroImage && (
              <Image src={post.data.heroImage} alt={post.data.title} style="width: 120px; height: 80px; object-fit: cover; border-radius: 8px; flex-shrink: 0;" />
            )}
            <div style="flex: 1; min-width: 0;">
              <div style="font-size: 16px; font-weight: 700; line-height: 1.4; margin-bottom: 6px;">{post.data.title}</div>
              <div style="font-size: 12px; color: var(--text-sub);">{fmtDate(post.data.pubDate)}</div>
            </div>
          </a>
        ))}
      </div>
    )}
  </main>
  <Footer />
</body>
</html>
