---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const uniqueTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))];
  return uniqueTags.map(tag => {
    const posts = allPosts.filter(post => post.data.tags?.includes(tag));
    return { params: { tag }, props: { posts, tag } };
  });
}

const { posts, tag } = Astro.props;
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={`タグ: ${tag} | Workbench Note`} description={`タグ「${tag}」の記事一覧`} />
  </head>
  <body>
    <Header />
    <main class="container" style="padding: 2rem 1rem; max-width: 800px; margin: 0 auto;">
      <h1 style="margin-bottom: 2rem;">タグ: {tag}</h1>
      <ul style="list-style: none; padding: 0;">
        {sortedPosts.map((post) => (
          <li style="margin-bottom: 1rem; border: 1px solid #eee; border-radius: 8px; overflow: hidden;">
            <a href={`/blog/${post.id}/`} style="display: block; padding: 15px; text-decoration: none; color: inherit;">
              <h2 style="margin: 0; font-size: 1.2rem;">{post.data.title}</h2>
              <p style="margin: 5px 0 0 0; color: #666; font-size: 0.9rem;">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>
