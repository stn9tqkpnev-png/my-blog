---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const uniqueTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))];
  return uniqueTags.map(tag => {
    const posts = allPosts.filter(post => post.data.tags?.includes(tag));
    return { params: { tag }, props: { posts, tag } };
  });
}
const { posts, tag } = Astro.props;
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmtDate = (d) => d.getFullYear() + "." + String(d.getMonth() + 1).padStart(2, "0") + "." + String(d.getDate()).padStart(2, "0");
---
<html lang="ja">
  <head><BaseHead title={ "タグ: " + tag + " | Workbench Note"} description={ "タグ「" + tag + "」の記事一覧"} /></head>
  <body>
    <Header />
    <section style="background-color: var(--navy); color: #fff; padding: 40px 24px; text-align: center;">
      <div style="max-width: 1120px; margin: 0 auto;"><span style="font-weight: 700; font-size: 12px; letter-spacing: 3px; color: var(--yellow); display: block; margin-bottom: 10px;">TAG</span><h1 style="font-size: 28px; margin: 0;">#{tag}</h1></div>
    </section>
    <main class="container" style="padding: 2rem 1rem; max-width: 800px; margin: 0 auto;">
      <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 20px;">
        {sortedPosts.map((post) => (
          <li>
            <a href={"/blog/" + post.id + "/"} class="wn-item" style="display: flex; gap: 16px; padding: 14px; text-decoration: none; color: inherit; align-items: center;">
              {post.data.heroImage && (<Image src={post.data.heroImage} alt={post.data.title} style="width: 120px; height: 80px; object-fit: cover; border-radius: 8px; flex-shrink: 0;" />)}
              <div style="flex: 1; min-width: 0;"><div style="font-size: 16px; font-weight: 700; line-height: 1.4; margin-bottom: 6px; color: #14213D;">{post.data.title}</div><div style="font-size: 12px; color: var(--text-sub);">{fmtDate(post.data.pubDate)}</div></div>
            </a>
          </li>
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>
