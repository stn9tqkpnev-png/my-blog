---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const allPosts = await getCollection("blog");
const uniqueTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))];
---
<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title="タグ一覧 | Workbench Note" description="すべてのタグの一覧です。" />
  </head>
  <body>
    <Header />
    <main class="container" style="padding: 2rem 1rem; max-width: 800px; margin: 0 auto;">
      <h1 style="margin-bottom: 2rem;">タグ一覧</h1>
      <ul style="list-style: none; padding: 0; display: flex; gap: 10px; flex-wrap: wrap;">
        {uniqueTags.map((tag) => (
          <li>
            <a href={`/tags/${tag}/`} style="display: inline-block; padding: 8px 16px; background: #f0f0f0; border-radius: 20px; text-decoration: none; color: #333; font-weight: bold;">
              {tag}
            </a>
          </li>
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>
