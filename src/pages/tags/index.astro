---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
const allPosts = await getCollection("blog");
const uniqueTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))];
---
<html lang="ja">
  <head><BaseHead title="タグ一覧 | Workbench Note" description="すべてのタグの一覧です。" /></head>
  <body>
    <Header />
    <section style="background-color: var(--navy); color: #fff; padding: 40px 24px; text-align: center;">
      <div style="max-width: 1120px; margin: 0 auto;"><span style="font-weight: 700; font-size: 12px; letter-spacing: 3px; color: var(--yellow); display: block; margin-bottom: 10px;">TAGS</span><h1 style="font-size: 28px; margin: 0;">タグ一覧</h1></div>
    </section>
    <main class="container" style="padding: 2rem 1rem; max-width: 800px; margin: 0 auto;">
      <ul style="list-style: none; padding: 0; display: flex; gap: 10px; flex-wrap: wrap;">
        {uniqueTags.map((tag) => (<li><a href={"/tags/" + tag + "/"} style="display: inline-block; padding: 8px 16px; background: var(--tag-bg); color: var(--tag-orange); border-radius: 20px; text-decoration: none; font-weight: bold;">#{tag}</a></li>))}
      </ul>
    </main>
    <Footer />
  </body>
</html>
