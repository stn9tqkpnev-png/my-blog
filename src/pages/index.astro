---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';

const allPosts = await getCollection('blog');
const uniqueTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))];
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<html lang="ja">
<head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
</head>
<body>
  <Header />
  <section style="background-color: var(--navy); color: #fff; padding: 60px 24px; text-align: center;">
    <div style="max-width: 800px; margin: 0 auto;">
      <span style="display: inline-block; background-color: var(--yellow); color: var(--navy); font-weight: bold; padding: 4px 12px; border-radius: 20px; font-size: 12px; margin-bottom: 20px; font-family: 'Poppins', sans-serif;">リアルな使用感をお届け</span>
      <h1 style="font-size: 32px; font-weight: bold; line-height: 1.5; margin-bottom: 20px; font-family: 'Noto Sans JP', sans-serif;">毎日をちょっと便利に、<br>もっと快適に。</h1>
      <p style="font-size: 15px; color: #ccc; margin-bottom: 30px;">ガジェットからスマートホームまで。実際に生活に取り入れて分かった本音のレビューと活用術。</p>
    </div>
  </section>
  <div class="container">
    <main>
      <h2 class="section-title">最新記事一覧</h2>
      <div class="article-list">
        {posts.map((post, index) => (
          index === 0 ? (
            <article class="article-card featured-post" style="flex-direction: row; align-items: stretch; margin-bottom: 32px;">
              <div class="article-body" style="flex: 1; padding: 24px; display: flex; flex-direction: column; justify-content: center;">
                <div style="display: flex; gap: 8px; margin-bottom: 12px;">
                  {post.data.tags && post.data.tags.map((tag) => (
                    <span style="background: #eef0f4; padding: 4px 10px; border-radius: 99px; font-size: 12px; color: #14213D; font-weight: 600;">#{tag}</span>
                  ))}
                </div>
                <h3 class="article-title" style="font-size: 24px; margin-bottom: 8px;"><a href={}>{post.data.title}</a></h3>
                <div class="article-meta" style="margin-bottom: 0;"><FormattedDate date={post.data.pubDate} /></div>
              </div>
              {post.data.heroImage && (
                <a href={} style="width: 45%; flex-shrink: 0;">
                  <Image src={post.data.heroImage} alt="" style="width: 100%; height: 100%; object-fit: cover;" />
                </a>
              )}
            </article>
          ) : (
            <article class="article-card list-post" style="flex-direction: row; align-items: center; margin-bottom: 16px;">
              {post.data.heroImage && (
                <a href={} style="width: 160px; flex-shrink: 0;">
                  <Image src={post.data.heroImage} alt="" style="width: 100%; height: 100px; object-fit: cover;" />
                </a>
              )}
              <div class="article-body" style="flex: 1; padding: 16px;">
                <div style="display: flex; gap: 8px; margin-bottom: 8px;">
                  {post.data.tags && post.data.tags.slice(0, 3).map((tag) => (
                    <span style="background: #eef0f4; padding: 2px 8px; border-radius: 99px; font-size: 11px; color: #14213D; font-weight: 600;">#{tag}</span>
                  ))}
                </div>
                <h3 class="article-title" style="font-size: 16px; margin-bottom: 4px;"><a href={}>{post.data.title}</a></h3>
                <div class="article-meta"><FormattedDate date={post.data.pubDate} /></div>
              </div>
            </article>
          )
        ))}
      </div>
    </main>
    <aside class="sidebar">
      <div style="background: #fff; border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); padding: 22px; margin-bottom: 24px; border-top: 4px solid var(--brand-orange);">
        <h3 style="font-size: 18px; margin-top: 0; margin-bottom: 12px;">About</h3>
        <p style="font-size: 14px; margin: 0; color: var(--text-sub);">Workbench Note へようこそ！ガジェット、技術、日常の記録を発信するマガジン型ブログです。</p>
      </div>
      
      <div style="background: #fff; border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); padding: 22px; border-top: 4px solid var(--brand-orange);">
        <h3 style="font-size: 18px; margin-top: 0; margin-bottom: 12px;">カテゴリー</h3>
        <ul style="padding-left: 0; margin: 0; font-size: 14px; list-style: none; display: flex; flex-wrap: wrap; gap: 8px;">
          {uniqueTags.map((tag) => (
            <li>
              <a href={`/tags/${tag}/`} style="display: inline-block; background: var(--tag-bg); color: var(--tag-orange); padding: 4px 12px; border-radius: 99px; border: 1px solid var(--border); font-size: 13px;">#{tag}</a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
  <Footer />

  <script>
    const loadMoreBtn = document.getElementById('load-more-btn');
    if (loadMoreBtn) {
      const items = document.querySelectorAll('.post-item');
      let visibleCount = 6;
      
      loadMoreBtn.addEventListener('click', () => {
        for (let i = visibleCount; i < visibleCount + 6 && i < items.length; i++) {
          items[i].style.display = 'flex';
        }
        visibleCount += 6;
        
        if (visibleCount >= items.length) {
          document.getElementById('load-more-wrapper').style.display = 'none';
        }
      });
    }
  </script>

</body>
</html>
