---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';

const allPosts = await getCollection('blog');
const uniqueTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))];
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 6);
---
<html lang="ja">
<head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
</head>
<body>
  <Header />
  <section style="background-color: var(--navy); color: #fff; padding: 60px 24px; text-align: center;">
    <div style="max-width: 800px; margin: 0 auto;">
      <span style="display: inline-block; background-color: var(--yellow); color: var(--navy); font-weight: bold; padding: 4px 12px; border-radius: 20px; font-size: 12px; margin-bottom: 20px; font-family: 'Poppins', sans-serif;">リアルな使用感をお届け</span>
      <h1 style="font-size: 32px; font-weight: bold; line-height: 1.5; margin-bottom: 20px; font-family: 'Noto Sans JP', sans-serif;">毎日をちょっと便利に、<br>もっと快適に。</h1>
      <p style="font-size: 15px; color: #ccc; margin-bottom: 30px;">ガジェットからスマートホームまで。実際に生活に取り入れて分かった本音のレビューと活用術。</p>
      <a href="/blog" class="btn-yellow">人気レビューを見る →</a>
    </div>
  </section>
  <div class="container">
    <main>
      <h2 class="section-title">最新記事一覧</h2>
      <div class="article-grid">
        {posts.map((post) => (
          <article class="article-card">
            {post.data.heroImage && (
              <a href={`/blog/${post.id}/`}><Image src={post.data.heroImage} alt="" class="article-thumb" /></a>
            )}
            <div class="article-body">
              <h3 class="article-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
              <div class="article-meta"><FormattedDate date={post.data.pubDate} /></div>
            </div>
          </article>
        ))}
      </div>
      <div style="text-align: center; margin-top: 40px;">
        <a href="/blog" class="btn-yellow" style="background-color: #fff; color: var(--brand-orange); border: 2px solid var(--brand-orange); border-bottom: 4px solid var(--brand-orange);">もっと見る</a>
      </div>
    </main>
    <aside class="sidebar">
      <div style="background: #fff; border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); padding: 22px; margin-bottom: 24px; border-top: 4px solid var(--brand-orange);">
        <h3 style="font-size: 18px; margin-top: 0; margin-bottom: 12px;">About</h3>
        <p style="font-size: 14px; margin: 0; color: var(--text-sub);">Workbench Note へようこそ！ガジェット、技術、日常の記録を発信するマガジン型ブログです。</p>
      </div>
      <div style="background: var(--navy); border-radius: 14px; border-bottom: 4px solid var(--yellow); padding: 22px; margin-bottom: 24px; color: #fff;">
        <h3 style="font-family: 'Poppins', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 2px; color: var(--yellow); margin-top: 0; margin-bottom: 12px;">PICK UP</h3>
        <p style="font-size: 14px; margin-bottom: 15px; line-height: 1.6;">T-Rex 2を3年間ガチで使用したリアルな評価はこちら！</p>
        <a href="/blog/trex2-review/" class="btn-yellow" style="display: block; font-size: 14px; padding: 10px;">レビューを読む</a>
      </div>
      <div style="background: #fff; border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); padding: 22px; border-top: 4px solid var(--brand-orange);">
        <h3 style="font-size: 18px; margin-top: 0; margin-bottom: 12px;">カテゴリー</h3>
        <ul style="padding-left: 0; margin: 0; font-size: 14px; list-style: none; display: flex; flex-wrap: wrap; gap: 8px;">
          {uniqueTags.map((tag) => (
            <li>
              <a href={`/tags/${tag}/`} style="display: inline-block; background: var(--tag-bg); color: var(--tag-orange); padding: 4px 12px; border-radius: 99px; border: 1px solid var(--border); font-size: 13px;">#{tag}</a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
  <Footer />
</body>
</html>
