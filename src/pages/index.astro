---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';

const allPosts = await getCollection('blog');
const uniqueTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))];
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<html lang="ja">
<head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
</head>
<body>
  <Header />
  <section style="background-color: var(--navy); color: #fff; padding: 60px 24px; text-align: center;">
    <div style="max-width: 800px; margin: 0 auto;">
      <span style="display: inline-block; background-color: var(--yellow); color: var(--navy); font-weight: bold; padding: 4px 12px; border-radius: 20px; font-size: 12px; margin-bottom: 20px; font-family: 'Poppins', sans-serif;">リアルな使用感をお届け</span>
      <h1 style="font-size: 32px; font-weight: bold; line-height: 1.5; margin-bottom: 20px; font-family: 'Noto Sans JP', sans-serif;">毎日をちょっと便利に、<br>もっと快適に。</h1>
      <p style="font-size: 15px; color: #ccc; margin-bottom: 30px;">ガジェットからスマートホームまで。実際に生活に取り入れて分かった本音のレビューと活用術。</p>
    </div>
  </section>
  <div class="container">
    <main>
      <h2 class="section-title">最新記事一覧</h2>
      <div class="article-list">
        {posts.map((post, index) => (
          index === 0 ? (
            <a href={`/blog/${post.id}/`} class="featured-card">
              <div class="featured-content">
                <div class="tag-list">
                  {post.data.tags && post.data.tags.map((tag) => (
                    <span class="tag">#{tag}</span>
                  ))}
                </div>
                <h3 class="featured-title">{post.data.title}</h3>
                <div class="meta"><FormattedDate date={post.data.pubDate} /></div>
              </div>
              {post.data.heroImage && (
                <div class="featured-image">
                  <Image src={post.data.heroImage} alt="" />
                </div>
              )}
            </a>
          ) : (
            <a href={`/blog/${post.id}/`} class="list-card">
              {post.data.heroImage && (
                <div class="list-image">
                  <Image src={post.data.heroImage} alt="" />
                </div>
              )}
              <div class="list-content">
                <div class="tag-list">
                  {post.data.tags && post.data.tags.slice(0, 3).map((tag) => (
                    <span class="tag">#{tag}</span>
                  ))}
                </div>
                <h3 class="list-title">{post.data.title}</h3>
                <div class="meta"><FormattedDate date={post.data.pubDate} /></div>
              </div>
            </a>
          )
        ))}
      </div>
    </main>

    <style>
      .featured-card, .list-card { background: #fff; border-radius: 14px; border-bottom: 4px solid var(--yellow); overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.05); text-decoration: none; color: inherit; display: flex; }
      .featured-card { flex-direction: row; margin-bottom: 24px; }
      .featured-content { flex: 1; padding: 32px; display: flex; flex-direction: column; justify-content: center; }
      .featured-image { width: 45%; flex-shrink: 0; display: block; }
      .featured-image img { width: 100%; height: 100%; object-fit: cover; }
      .featured-title { font-size: 24px; font-weight: bold; margin: 0 0 16px 0; line-height: 1.4; }
      
      .list-card { flex-direction: row; margin-bottom: 16px; align-items: center; }
      .list-image { width: 200px; flex-shrink: 0; display: block; }
      .list-image img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 16/9; }
      .list-content { flex: 1; padding: 20px; }
      .list-title { font-size: 16px; font-weight: bold; margin: 0 0 8px 0; line-height: 1.5; }

      .tag-list { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
      .tag { display: inline-block; background: #eef0f4; padding: 4px 10px; border-radius: 99px; font-size: 12px; color: #14213D; font-weight: 600; white-space: nowrap; }
      .meta { font-size: 13px; color: #666; }

      @media (max-width: 768px) {
        .featured-card { flex-direction: column; }
        .featured-image { width: 100%; aspect-ratio: 16/9; }
        .list-card { flex-direction: column; align-items: stretch; }
        .list-image { width: 100%; aspect-ratio: 16/9; }
      }
    </style>
    <aside class="sidebar">
      <div style="background: #fff; border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); padding: 22px; margin-bottom: 24px; border-top: 4px solid var(--brand-orange);">
        <h3 style="font-size: 18px; margin-top: 0; margin-bottom: 12px;">About</h3>
        <p style="font-size: 14px; margin: 0; color: var(--text-sub);">Workbench Note へようこそ！ガジェット、技術、日常の記録を発信するマガジン型ブログです。</p>
      </div>
      
      <div style="background: #fff; border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); padding: 22px; border-top: 4px solid var(--brand-orange);">
        <h3 style="font-size: 18px; margin-top: 0; margin-bottom: 12px;">カテゴリー</h3>
        <ul style="padding-left: 0; margin: 0; font-size: 14px; list-style: none; display: flex; flex-wrap: wrap; gap: 8px;">
          {uniqueTags.map((tag) => (
            <li>
              <a href={`/tags/${tag}/`} style="display: inline-block; background: var(--tag-bg); color: var(--tag-orange); padding: 4px 12px; border-radius: 99px; border: 1px solid var(--border); font-size: 13px;">#{tag}</a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
  <Footer />

  <script>
    const loadMoreBtn = document.getElementById('load-more-btn');
    if (loadMoreBtn) {
      const items = document.querySelectorAll('.post-item');
      let visibleCount = 6;
      
      loadMoreBtn.addEventListener('click', () => {
        for (let i = visibleCount; i < visibleCount + 6 && i < items.length; i++) {
          items[i].style.display = 'flex';
        }
        visibleCount += 6;
        
        if (visibleCount >= items.length) {
          document.getElementById('load-more-wrapper').style.display = 'none';
        }
      });
    }
  </script>

</body>
</html>
