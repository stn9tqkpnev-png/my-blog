---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';

const posts = (await getCollection('blog')).sort(
(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="ja">
<head>
<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
</head>
<body>
<Header />
<div class="container">
<main class="main-content">
<h2 style="margin: 0 0 0.5rem 0; font-size: 1.2rem; border-left: 4px solid var(--accent-color); padding-left: 0.5rem;">最新記事一覧</h2>
{
posts.map((post) => (
<article class="article-card">
{post.data.heroImage && (
<Image src={post.data.heroImage} alt="" class="article-thumb" />
)}
<div class="article-body">
<h3 class="article-title">
<a href={`/blog/${post.id}/`}>{post.data.title}</a>
</h3>
<div class="article-meta">
<FormattedDate date={post.data.pubDate} />
</div>
<p class="article-description">{post.data.description}</p>
</div>
</article>
))
}
</main>
<aside class="sidebar">
<div class="widget">
<h3 class="widget-title">About</h3>
<p style="font-size: 0.9rem; margin: 0;">Workbenchへようこそ！ガジェット、技術、日常の記録を発信するマガジン型ブログです。</p>
</div>
<div class="widget">
<h3 class="widget-title">カテゴリー</h3>
<ul style="padding-left: 1.2rem; margin: 0; font-size: 0.9rem;">
<li>ガジェット</li>
<li>WEB・開発</li>
<li>レビュー</li>
</ul>
</div>
</aside>
</div>
<Footer />
</body>
</html>
