---
interface Props {
  title: string;
}
const { title } = Astro.props;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ホーム", "item": Astro.site ? new URL("/", Astro.site).toString() : "/" },
    { "@type": "ListItem", "position": 2, "name": "ブログ", "item": Astro.site ? new URL("/blog/", Astro.site).toString() : "/blog/" },
    { "@type": "ListItem", "position": 3, "name": title, "item": Astro.url.toString() }
  ]
};
---
<nav aria-label="パンくずリスト" class="breadcrumbs">
  <ol>
    <li><a href="/">ホーム</a></li>
    <li><a href="/blog/">ブログ</a></li>
    <li aria-current="page">{title}</li>
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<style>
  .breadcrumbs { font-size: 0.85rem; color: var(--sub-text); margin-bottom: 1.5rem; }
  .breadcrumbs ol { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .breadcrumbs li { display: flex; align-items: center; }
  .breadcrumbs li:not(:last-child)::after { content: "›"; margin-left: 0.5rem; color: #ccc; }
  .breadcrumbs a { color: var(--accent-color); text-decoration: none; }
  .breadcrumbs a:hover { text-decoration: underline; }
  .breadcrumbs li[aria-current="page"] { color: var(--text-color); font-weight: bold; }
</style>