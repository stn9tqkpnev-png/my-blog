---
interface Props {
  url: string;
  image: string;
  title: string;
  buttonText?: string;
}
const { url, image, title, buttonText = "Amazonで詳細を見る ▶" } = Astro.props;
---
<div style="max-width: 400px; margin: 0 auto 20px auto; border: 1px solid #ddd; border-radius: 12px; overflow: hidden; background: #fff;">
  <a href={url} target="_blank" rel="noopener" style="text-decoration: none; display: block; padding: 15px; text-align: center;">
    <img src={image} alt={title} style="max-width: 80%; height: auto; border-radius: 8px; margin-bottom: 10px; display: inline-block;">
    <p style="color: #333; font-weight: bold; margin: 0 0 10px 0;">{title}</p>
    <div style="background-color: #ff9900; color: #fff; padding: 10px 20px; border-radius: 8px; font-weight: bold; display: inline-block;">
      {buttonText}
    </div>
  </a>
</div>
