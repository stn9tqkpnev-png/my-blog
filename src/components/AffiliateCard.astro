---
interface Props {
  url: string;
  image: string;
  title: string;
  buttonText?: string;
}
const { url, image, title, buttonText = "Amazonで見る ▶" } = Astro.props;
---
<div class="affiliate-box">
  <span class="pr-badge">PR</span>
  <a href={url} target="_blank" rel="sponsored noopener" style="text-decoration: none; display: block;">
    <img src={image} alt={title} style="max-width: 120px; height: auto; border-radius: 8px; margin-bottom: 15px; display: inline-block;">
    <p style="color: #fff; font-size: 16px; margin: 0 0 15px 0;">{title}</p>
    <div class="btn-affiliate">{buttonText}</div>
  </a>
</div>
