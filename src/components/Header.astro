---
import { SITE_TITLE } from '../consts';
---
<header class="site-header">
  <div style="max-width: 1100px; margin: 0 auto;">
    <h1 class="site-title">
      <a href="/" style="text-decoration: none; display: flex; align-items: baseline; font-family: 'Arial Black', Impact, sans-serif; letter-spacing: -2px; white-space: nowrap;">
        <span style="color: #ffffff; font-size: 3.5rem; font-weight: 900; -webkit-text-stroke: 3px #0055aa; text-shadow: 4px 4px 0 #00ccff;">Workbench</span>
        <span style="color: #ffffff; font-size: 3rem; font-weight: 900; font-style: italic; -webkit-text-stroke: 3px #000000; text-shadow: 4px 4px 0 #ff9900; margin-left: 10px; display: inline-block; transform: rotate(-8deg);">Note</span>
      </a>
    </h1>
    <nav class="nav-links">
      <a href="/">HOME</a>
      <a href="/blog">ALL POSTS</a>
      <a href="/profile">PROFILE</a>
    </nav>
  </div>
</header>